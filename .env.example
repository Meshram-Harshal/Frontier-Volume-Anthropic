# Base58 secret key of the wallet that will swap. Never commit the real .env.
PRIVATE_KEY=

# Solana RPC. A private RPC lands faster than the public one.
RPC_URL=

# Optional. Paid Jupiter key uses api.jup.ag. Leave blank to use the free lite API.
API_KEY=

# Mint of the coin you are farming. USDC is the other side of every swap.
TOKEN_MINT=ANTBTZQ1EUuTxUs3tfeampxdqTWPHmwyJmcWj4xoAyNe

# Buy size in USDC, pause between a buy and the following sell, and stop target.
BUY_USDC=100
INTERVAL_SEC=15
TARGET_VOLUME_USD=70000

# Slippage in basis points. 100 = 1%. Raise this if swaps fail on a volatile coin.
SLIPPAGE_BPS=50

# Extra priority fee per swap, in lamports. 48800 = 0.0000488 SOL.
# Base network fee is about 0.00001 SOL, so the total is about 0.0000588 SOL.
MAX_PRIORITY_LAMPORTS=48800
